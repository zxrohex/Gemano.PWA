<div class="chat-footer">
    <div class="prompt-input-container">
        <InputText class="prompt-text-input" @bind-Value="input">

        </InputText>

        <button class="prompt-input-send-btn" @onclick="Submit">
            Send
        </button>

    </div>
</div>
@code {
    string input = "";

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    async Task Submit()
    {
        await OnSubmit.InvokeAsync(input);

        input = "";
    }
}
