<div class="chat-footer">
    <div class="prompt-input-container">
        <InputText class="prompt-text-input" @bind-Value="input">

        </InputText>

        <InputFile OnChange="OnInputFileChange" >

        </InputFile>

      

        <button class="prompt-input-send-btn" @onclick="Submit">
            Send
        </button>

    </div>
</div>
@code {
    string input = "";

    IBrowserFile file;

    [Parameter]
    public EventCallback<Core.Models.ChatMessage> OnSubmit { get; set; }

    async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        file = e.File;
    }

    async Task Submit()
    {
        await OnSubmit.InvokeAsync(file != null ? Core.Models.ChatMessage.FromUser(input, await file.ReadAllAsBytes()) : Core.Models.ChatMessage.FromUser(input));

        input = "";

        file = null;
    }

   
}
