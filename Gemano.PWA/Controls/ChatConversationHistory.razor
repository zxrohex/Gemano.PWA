<div class="chat-messages">


    @foreach (var msg in Messages.Skip(1))
    {
        <div class="chat-message @(string.IsNullOrEmpty(msg.Content) ? "skeleton" : "")">
            <div class="message-header">
                <div class="message-header-content">
                    <h6>@msg.Role.ToUpper()</h6>
                </div>

                <div class="message-header-content">
                    <h6>...</h6>
                </div>
            </div>

            <div class="message-content">
                <p>@(string.IsNullOrEmpty(msg.Content) ? "..." : msg.Content)</p>
            </div>
        </div>
    }



</div>

@code {
    [Parameter]
    public List<LanguageModelConversation.LanguageModelMessage> Messages { get; set; }
}
