@page "/Chat"
@inject IJSRuntime JSRuntime
@inject LanguageModelService LanguageModelService

<PageTitle>Chat</PageTitle>

@if (isReady)
{
    <div class="chat-view">

        <div class="chat-header">
            <div class="chat-header-content">
                <InputText class="chat-name-field" @bind-Value="conversation.Name">

                </InputText>
            </div>

            <div class="chat-header-content">
                <div class="chat-quota-container">
                    <div class="chat-quota">
                        <p>@usage of @quota</p>
                    </div>

                    <div class="chat-quota-progress-bar">
                        <div class="chat-quota-progress" id="chat-quota-progress">
                            <div class="chat-quota-progress-fill"
                                 id="chat-quota-progress-fill" style="width: @(usage / quota * 100)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ChatConversationHistory Messages="conversation.Messages">

        </ChatConversationHistory>

        <div class="conversation-controls">
            <ChatInput OnSubmit="OnSubmitted">

            </ChatInput>
        </div>
    </div>
}
else
{
    <div class="loading-bar">
        <div class="bar">
            <div class="bar-border top">
            </div>

            <div class="bar-border bottom">
            </div>

            <div class="bar-border left">
            </div>

            <div class="bar-border right">
            </div>
        </div>
    </div>


}


@code {
    bool isReady = true;

    LanguageModelConversation conversation = new LanguageModelConversation("New Chat");

    LanguageModelSession session;

    int usage, quota = 1;

    async Task OnSubmitted(string input)
    {
        conversation.AddUserMessage(input);

        var targetMsg = conversation.AddAssistantMessage("");

        var response = await session.Prompt(input);

        targetMsg.Content = response;

        await RefreshStats();
    }

    async Task RefreshStats()
    {
        usage = await session.GetInputUsage();

        quota = await session.GetInputQuota();
    }

    protected override async Task OnParametersSetAsync()
    {
        session = await LanguageModelService.Create();
    }
}
