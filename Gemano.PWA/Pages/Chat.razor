@page "/Chat"
@page "/Chat/{id}"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject LanguageModelService LanguageModelService
@inject LanguageModelConversationManager LanguageModelConversationManager
@inject NavigationManager NavigationManager

<PageTitle>Chat</PageTitle>

@if (isReady)
{
    <div class="chat-view">

        <div class="chat-header">
            <div class="chat-header-content">
                <InputText class="chat-name-field" @bind-Value="conversation.Name">

                </InputText>
            </div>

            <div class="chat-header-content">
                <div class="chat-quota-container">
                    <div class="chat-quota">
                        <p>@usage of @quota</p>
                    </div>

                    <div class="chat-quota-progress-bar">
                        <div class="chat-quota-progress" id="chat-quota-progress">
                            <div class="chat-quota-progress-fill"
                                 id="chat-quota-progress-fill" style="width: @Math.Round((double)usage / quota * 100, 0)% !important"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ChatConversationHistory Messages="conversation.Messages">

        </ChatConversationHistory>

        <div class="conversation-controls">
            <ChatInput OnSubmit="OnSubmitted">

            </ChatInput>
        </div>
    </div>
}
else
{
    <h1>Loading...</h1>

    <!--<div class="loading-bar">
        <div class="bar">
            <div class="bar-border top">
            </div>

            <div class="bar-border bottom">
            </div>

            <div class="bar-border left">
            </div>

            <div class="bar-border right">
            </div>
        </div>
    </div>-->


}


@code {
    [Parameter]
    public string Id {get; set; }

    bool isReady = false;

    LanguageModelConversation conversation;

    LanguageModelSession session;

    int usage, quota = 1;

    async Task OnSubmitted(string input)
    {
        conversation.AddUserMessage(input);

        var targetMsg = conversation.AddAssistantMessage("");

        var response = await session.Prompt(input);

        targetMsg.Content = response;

        await RefreshStats();
    }

    async Task RefreshStats()
    {
        usage = await session.GetInputUsage();

        quota = await session.GetInputQuota();
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine("--- Chat Init ---");

        if (Id == null)
        {
            Console.WriteLine("ID is null, creating conv");

            var conv = new LanguageModelConversation("New Chat");

            Console.WriteLine("Adding conv to localStorage");

            bool done = await LanguageModelConversationManager.AddConversation(conv);

            Console.WriteLine("Creating LM session");

            if (done)
            {
                Console.WriteLine("!! Navigating / redirect to URL with Id !!");

                NavigationManager.NavigateTo($"/Chat/{conv.Id}");
            }
        }
        else
        {
            Console.WriteLine("ID is NOT null");

            Console.WriteLine("Getting conversation");

            conversation = await LanguageModelConversationManager.GetConversation(Id);

            Console.WriteLine("Creating LM session");

            session = await LanguageModelService.Create(conversation.Messages);

            isReady = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Console.WriteLine("!! --- Disposing Chat page / view --- !!");

        conversation = null;

        await session.Destroy();

        session = null;
    }
}
