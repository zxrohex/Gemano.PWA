@page "/Chat"
@inject IJSRuntime JSRuntime

<PageTitle>Chat</PageTitle>

    <div class="chat-view">

        <div class="chat-header">
            <div class="chat-header-content">
                <InputText class="chat-name-field" @bind-Value="name">

                </InputText>
            </div>

            <div class="chat-header-content">
                <div class="chat-quota-container">
                    <div class="chat-quota">
                        <p>@usage of @quota</p>
                    </div>

                    <div class="chat-quota-progress-bar">
                        <div class="chat-quota-progress" id="chat-quota-progress">
                            <div class="chat-quota-progress-fill"
                                 id="chat-quota-progress-fill" style="width: @Math.Round((double)usage / quota * 100, 0)% !important"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ChatConversation Messages="messages">

        </ChatConversation>

        <div class="conversation-controls">
            <ChatInput OnSubmit="OnSubmitted">

            </ChatInput>
        </div>
    </div>

     <!--
         -->




@code {
    IJSObjectReference llmSession;

    List<Core.Models.ChatMessage> messages = new List<Core.Models.ChatMessage>() 
    {
        Core.Models.ChatMessage.FromSystem("Test")
    };

    string name = "Test Chat";

    double quota = -1;

    double usage = -1;

    protected override async Task OnParametersSetAsync()
    {
        await InitializeLLMSession();
    }

    async Task InitializeLLMSession()
    {
        llmSession = await JSRuntime.InvokeAsync<IJSObjectReference>("window.LanguageModel.create", new { expectedInputs = new[] { new { type = "text" }, new { type = "image" }, new { type = "audio" } } });

        await RefreshStats();
    }

    async Task RefreshStats()
    {
        if (llmSession is not null)
        {
            quota = await llmSession.GetValueAsync<double>("inputQuota");
            usage = await llmSession.GetValueAsync<double>("inputUsage");
        }
    }

    async Task<Core.Models.ChatMessage> Prompt(Core.Models.ChatMessage chatMessage)
    {
        if (llmSession is not null)
        {
            var args = new[] { new { role = chatMessage.Role, content = chatMessage.Contents.Select(i => new { type = i.Type, value = i.Content }) } };

            Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(args));

            var response = await llmSession.InvokeAsync<string>("prompt", args);

            return Core.Models.ChatMessage.FromAssistant(response);
        }

        return null;
    }

    async Task OnSubmitted(Core.Models.ChatMessage message)
    {
        messages.Add(message);
        

        var response = await Prompt(message); // Added this line to call the Prompt method
          

        messages.Add(response);
    }
}
