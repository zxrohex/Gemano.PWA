@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject AIServicesManager AIServicesManager

<div class="app-container">
    @if (init)
    {
        <Sidebar @ref="sidebar">

        </Sidebar>

        <div class="app-header">
            <div class="header-container left">
                <h1>Gemano</h1>
            </div>

            <div class="header-container center">
            </div>

            <div class="header-container right">

                <button @onclick="test">
                    Menu
                </button>

            </div>
        </div>

        <div class="app-main">
            @Body
        </div>
    }
    else
    {
        <div class="app-main loading">
            <div class="loading-bar">
                <div class="bar">
                    <div class="bar-border top">
                    </div>

                    <div class="bar-border bottom">
                    </div>

                    <div class="bar-border left">
                    </div>

                    <div class="bar-border right">
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    bool init = false;

    Sidebar sidebar;

    protected override async Task OnParametersSetAsync()
    {
        AIServicesManager.OnDownloadProgress += (l, t) =>
        {
            
        };


        await AIServicesManager.InitializeAsync();

        init = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {


        }
    }

    async Task test()
    {
        sidebar.Toggle();
    }
}
